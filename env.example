# Frontend: only public Supabase configuration belongs in VITE_* variables.
# Do not add search/generation API credentials or SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy alternative (used only if the publishable variable above is absent):
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
